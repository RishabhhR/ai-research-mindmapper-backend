# ── LLM Providers ──────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here        # optional fallback
OPENROUTER_API_KEY=your_openrouter_key_here    # optional 3rd fallback
# GROQ_MODEL=llama-3.1-8b-instant

# ── Database (Turso — required) ─────────────────────────────
# 1. brew install tursodatabase/tap/turso
# 2. turso auth signup
# 3. turso db create mindmapper-db
# 4. turso db show mindmapper-db --url   → paste below
# 5. turso db tokens create mindmapper-db → paste below
TURSO_URL=libsql://mindmapper-db-<your-username>.turso.io
TURSO_AUTH_TOKEN=your_turso_token_here

# ── Auth (Clerk) ────────────────────────────────────────────
# CLERK_PUBLISHABLE_KEY=pk_test_...   # derives the JWKS URL

# ── Background jobs (YouTube pipeline) ──────────────────────
# Random string; protects the internal worker endpoint. If unset,
# jobs run inline in the request instead (slower, never exposed).
# INTERNAL_SECRET=generate_a_long_random_string
# BACKEND_URL=https://your-backend.vercel.app

# ── Rate limiting (per user) ────────────────────────────────
# RATE_LIMIT_LLM_PER_MIN=6
# RATE_LIMIT_LLM_PER_DAY=120
# RATE_LIMIT_INGEST_PER_MIN=12
# RATE_LIMIT_INGEST_PER_DAY=200
# RATE_LIMIT_DISABLED=1            # local dev / load tests only

# ── CORS ────────────────────────────────────────────────────
# Comma-separated extra allowed origins (prod frontend is built in)
# FRONTEND_URLS=https://your-frontend.vercel.app

# ── YouTube transcript pipeline (all optional) ──────────────
# SUPADATA_API_KEY=...             # transcript API, step 1
# EDGE_TRANSCRIPT_URL=https://research-mindmapper-vite.vercel.app/api/yt-transcript
# YOUTUBE_COOKIES_B64=...          # cookie-authenticated fallback
# YOUTUBE_PIPELINE_TIMEOUT=50
# YOUTUBE_STATUS=ok                # set "degraded"/"down" to show banner

# ── Misc ────────────────────────────────────────────────────
# GENERATE_BUDGET_SECONDS=45       # research wall-clock budget
# LOG_LEVEL=INFO
# STRESS_TEST_KEY=...              # auth bypass for load tests; never in prod
# SCRIPT_API_KEY=...               # auth bypass for local scripts
# EXTENSION_PUBLIC_KEY=...         # Chrome extension shared key
